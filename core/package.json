{
  "name": "jsails",
  "version": "1.0.0",
  "private": false,
  "description": "TypeScript application framework: Active Record ORM with declarative schema reconciliation, filesystem pages and APIs, server components with soft navigation, plugins with an admin panel, and Jamal local/deploy tooling.",
  "license": "MIT",
  "keywords": [
    "typescript",
    "framework",
    "active-record",
    "orm",
    "migrations",
    "ssr",
    "server-components",
    "static-export",
    "plugins",
    "admin",
    "cli",
    "deploy",
    "preact",
    "hono"
  ],
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git"
  },
  "bugs": {
