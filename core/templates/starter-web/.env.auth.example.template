# Example environment for the generated app (`jsails.app.js`).
#
# Copy this file to `.env` and fill it in. Every `jsails` command (`dev`,
# `serve`, `build`, `db:push`, `test`) resolves its environment before it
# imports the app: `.env`, then `.env.<JSAILS_ENV>` (`.env.development`, or
# `.env.test` under `jsails test`), then the sealed credentials, then
# `.env.local` (development only), and a real environment variable always wins
# over every file. Environments other than development and test (production,
# staging) read no `.env` file at all. `npm run auth:migrate` and `npm run user:create`
# run plain Node scripts, so their npm scripts load `.env` and `.env.local`
# through Node's `--env-file-if-exists`. `.env` and `.env.*` are git-ignored;
# only this example is committed. In production, `jamal deploy` delivers the
# variables listed in `jamal.config.ts` from `.jamal/secrets*` instead.

# Required in production. Better Auth fails without a secret; JSails does not
# invent a fallback. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required in production. Signs server-component state; a `jsails serve`
# outside development/test fails live renders closed without it (>= 32 bytes).
JSAILS_COMPONENT_SECRET=

# Required. MariaDB connection for Better Auth (the recommended default; start
# it with `jamal up`). Auth requires a database connection, and JSails reads
# these variables individually — there is no DATABASE_URL.
DATABASE_HOST=
#DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# The MariaDB root password `jamal up` initializes the local container with.
DATABASE_ROOT_PASSWORD=

# Required in production. The public HTTPS origin the browser uses, for
# example `https://example.com`. Better Auth marks its session cookie `Secure`
# (with the `__Secure-` prefix) only when BETTER_AUTH_URL is https, and the
# login/logout same-origin checks compare against PUBLIC_ORIGIN; behind a
# TLS-terminating proxy the request itself looks like plain HTTP. Both default
# to localhost / the request origin in development. `jamal.config.ts` derives
# both from the one PUBLIC_ORIGIN secret on deploy.
#BETTER_AUTH_URL=http://localhost:3000
#PUBLIC_ORIGIN=http://localhost:3000

# Optional. The reverse proxies trusted to report the client (default none):
# `none`, `hops=<n>`, a comma-separated list of CIDR ranges, or `hops=<n>`
# followed by such a list (the nearest proxies, then upstream ranges). The rate limits
# and Better Auth key on the client address: with `none` that is the socket
# peer; with `hops=N` it is the N-th X-Forwarded-For entry from the
# right, the one the outermost trusted proxy appended. `jamal deploy` sets it
# for the proxies it puts in front of the app (kamal-proxy, the cache proxy,
# and `proxy` in `jamal.config.ts`); set it yourself only behind another
# reverse proxy: left at `none` there, every client shares the proxy's
# address, and a count larger than the real number of proxies falls back to
# it. `server.trustedProxies` in `jsails.app.js` wins over it.
#JSAILS_TRUSTED_PROXIES=none

# SaaS preset only. The apex tenants sit under (`acme.example.com` names the
# `acme` tenant under `example.com`). Unset, every request is global. The SaaS
# `jamal.config.ts` forwards it on deploy, so `jamal deploy` requires a
# TENANT_ROOT_DOMAIN secret.
#TENANT_ROOT_DOMAIN=example.com

# Optional. Blob storage backend: `local` (default, under storage/files) or `s3`.
# The same FILESYSTEM_* / S3_* variables drive the filesystem plugin and the
# blog media library, so switching is one line.
#FILESYSTEM_DISK=local
#FILESYSTEM_LOCAL_ROOT=storage/files
#S3_BUCKET=
#S3_REGION=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_SESSION_TOKEN=
#S3_ENDPOINT=
#S3_FORCE_PATH_STYLE=false
# false for a store that ignores If-None-Match (the SeaweedFS jamal runs).
#S3_CONDITIONAL_WRITES=true
#S3_PREFIX=
