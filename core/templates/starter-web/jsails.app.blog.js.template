import { JsailsDataSource, readDatabaseEnvironment } from 'jsails';
import { defineAdminPanel, withAdminAuthorize } from '@jsails/admin';
import {
  blogEntities,
  blogSiteConfig,
  createBlogSearchEngine,
  createDatabaseBlogRepository,
} from '@jsails/blog';
import { blogAdmin, blogThemeAdmin } from '@jsails/blog/admin';
import { configEntities, configPlugin, createDatabaseConfigStore } from '@jsails/config';
import { configAdmin } from '@jsails/config/admin';
import { editorJsAdapter } from '@jsails/editor';
import { createDatabaseMediaIndex, createMediaLibrary, mediaEntities } from '@jsails/media';
import { mediaAdmin } from '@jsails/media/admin';
import { builtinThemePackages, createThemeRegistry } from '@jsails/theme';
import { adminOnly, authSessionToken } from '@jsails/auth';
import { createDiskFromEnv } from '@jsails/filesystem';
import { createPublicationRegistry } from 'jsails/live';

// Auth is the `auth` plugin (`@jsails/auth`): it lazily builds a
// Better Auth instance (email/password + RFC 8628 device authorization) over
// MariaDB and mounts the `/api/auth/*`, `/api/login`, `/api/logout`, and
// `/api/device/approve|deny` routes as trusted hook routes. Importing this
// config reads no environment variable and opens no database connection — the
// first live request (or an auth script) builds the instance. The secret comes
// from BETTER_AUTH_SECRET (or AUTH_SECRET); Better Auth fails in production
// without one, and JSails does not invent a fallback. `.env.auth.example` lists
// the variables: copy it to `.env`, which every `jsails` command (`dev`,
// `serve`, `build`, `db:push`) loads before this module is imported, with a real
// environment variable always winning over the file.

// The app's public origin (`server.origin`). Every request is addressed to it
// or answered 421, the same-origin checks compare with it, and behind a
// TLS-terminating proxy it supplies the https scheme the request URL lacks.
// Serving outside development and test requires it; `jamal.config.ts`
// forwards it in production. Unset (or empty) in development, any Host is
// accepted as its own origin.
const publicOrigin = process.env.PUBLIC_ORIGIN || undefined;

// The admin panel fails closed: `adminOnly` admits only a session whose user
// holds the `admin` role. The role lives in a column of Better Auth's user
// table that no sign-up or profile endpoint can write; only `setUserRole` (from
// `@jsails/auth`) assigns it, so self-registration never yields an admin. Make
// the first admin from the command line:
// `npm run user:create -- you@example.com '<password>' --role admin`.

// The trusted session seam reuses the `auth` plugin's own resolver, so the app
// holds one Better Auth instance and one connection pool, which the plugin
// releases on shutdown. This extension runs after `plugins.use` and captures
// the plugin's session service; until it has run, and again once the
// application shuts down (Node caches this config module, so a later app built
// from it must not reach a closed instance), no request has a session.
let authSessions;
const authSessionBridge = {
  name: 'app-auth-session',
  requires: [authSessionToken],
  setup: ({ services }) => {
    const captured = services.get(authSessionToken);
    authSessions = captured;
    return () => {
      if (authSessions === captured) authSessions = undefined;
    };
  },
};
const resolveSession = (request) =>
  authSessions === undefined ? null : authSessions.resolveSession(request);

// One lazy shared data source backs the blog content repository, the media
// metadata index, and the site config, so the app opens a single connection
// pool. Constructing it reads DATABASE_* but does not connect
// until the first query, so importing this config, running `jsails build`
// (static export), and rendering the SSG blog pages never open a database
// connection. The `jsails_blog_content_*`, `jsails_media_asset`, and
// `jsails_config` tables are declared by the plugin schemas and the entity list
// below; run `npm run db:push` first. The app
// closes the source on shutdown.
let dataSource;
const getDataSource = () => {
  dataSource ??= new JsailsDataSource({
    ...readDatabaseEnvironment(),
    entities: [...blogEntities, ...mediaEntities, ...configEntities],
  });
  return dataSource;
};

// One shared, database-backed CMS repository backs both the `blog` plugin's
// public `GET /blog` routes and the `blog` admin resource. The public
// `POST /blog/posts` create route stays unmounted: the plugin only mounts it
// when given a `createRoute` with its own `authorize`, and posts are written
// through the admin panel instead.
const blogRepository = createDatabaseBlogRepository({ getDataSource });

// One shared search engine backs both the public `GET /blog/search` route and
// the admin save-time indexer, so a post saved in the admin is immediately
// findable. `SEARCH_DRIVER` selects the engine (default `orama`, the embedded
// index); `database` needs no service, while `meilisearch`/`typesense`/
// `opensearch` read `SEARCH_URL`, `SEARCH_API_KEY`, and `SEARCH_INDEX`.
const search = createBlogSearchEngine({
  driver: process.env.SEARCH_DRIVER ?? 'orama',
  repository: blogRepository,
  url: process.env.SEARCH_URL,
  apiKey: process.env.SEARCH_API_KEY,
  index: process.env.SEARCH_INDEX,
});

// One shared disk backs both the `filesystem` plugin and the media library.
// `FILESYSTEM_DISK` selects `local` (the default, rooted at
// `storage/files`) or `s3`; the `S3_*` variables supply the bucket and
// credentials. Both surfaces therefore read and write the same bytes. Media
// metadata (alt/caption/MIME/dimensions) is persisted in the
// `jsails_media_asset` table through the shared data source, keyed under the
// `media/` prefix.
const files = createDiskFromEnv();
const mediaIndex = createDatabaseMediaIndex({ getDataSource });
const mediaLibrary = createMediaLibrary({
  disk: files.disk,
  diskName: files.name,
  metadata: mediaIndex,
});

// One theme registry over the built-in theme packages. The active
// theme is the first package (sorted by name) until the admin surface persists
// a `theme.active` setting through `blogThemeAdmin`; the name is stored as a
// setting (no new database table), and each activation below returns a new
// immutable registry rather than mutating this one.
const themeRegistry = createThemeRegistry({ packages: builtinThemePackages });

// Site config (`@jsails/config`): the blog's `blog.site` set (title, tagline,
// posts per page, timezone, social links), edited on the admin Configuration
// page and stored in `jsails_config`. `npx jsails config:export` writes it to
// `config/sync/` for you to commit; `npx jsails config:import` applies those
// files on another environment. To force a value per environment, add
// `overrides: { 'blog.site': { title: process.env.SITE_TITLE } }`.
const siteConfig = configPlugin({
  sets: [blogSiteConfig],
  store: createDatabaseConfigStore({ getDataSource }),
});

// The admin panel: a dashboard mounted at `/admin`. It consumes the auth
// plugin's session service (so the `auth` plugin must be declared first),
// and its `authorize` is default-deny: only an `admin`-role session
// is admitted. Every admin page, resource, and action is default-deny as well:
// one without its own `authorize` is reachable by no one. The blog, media,
// theme, and configuration admin plugins declare none, so each is granted
// `adminOnly` explicitly through `withAdminAuthorize`. Plugins are installed
// with npm and declared below; nothing is installed or enabled from the admin.
const admin = defineAdminPanel({
  auth: authSessionToken,
  authorize: adminOnly,
  // Admin pages load the client bundle so the rich-text editor island (and any
  // other app islands) hydrate over the server-rendered admin form markup.
  clientScripts: ['/assets/app.js'],
  adminPlugins: [
    blogAdmin({
      repository: blogRepository,
      editor: editorJsAdapter,
      mediaPickerUrl: '/admin/media?format=json',
      search,
    }),
    mediaAdmin({ library: mediaLibrary }),
    blogThemeAdmin({ registry: themeRegistry, repository: blogRepository }),
    configAdmin({ config: siteConfig.config }),
  ].map((plugin) => withAdminAuthorize(plugin, adminOnly)),
});

export default {
  rootDir: '.',
  pages: 'dist/pages',
  api: 'dist/api',
  public: 'public',
  out: 'out',
  host: '127.0.0.1',
  port: Number(process.env.PORT ?? 3000),
  // The public origin and the proxies trusted to report the client (read from
  // JSAILS_TRUSTED_PROXIES; `jamal.config.ts` sets it for kamal-proxy).
  server: { origin: publicOrigin },
  // Global API authorization: default-deny. Only a request with a session is
  // allowed; `/api/me` is the protected filesystem API, while login/logout are
  // trusted hook routes that never pass through this check.
  authorize: (context) => context.session !== null,
  // Trusted session seam: the `auth` plugin's resolver, captured above.
  resolveSession,
  // Close the shared data source when the application closes. A no-op when no
  // query ever opened it (the source connects lazily).
  setup: () => async () => {
    if (dataSource?.isInitialized) {
      await dataSource.destroy();
    }
  },
  // The config plugin is an extension rather than a `plugins.use` entry, so the
  // CLI sees its `config:export`/`config:import` commands and the admin page
  // shares its service.
  extensions: [siteConfig, authSessionBridge],
  plugins: {
    // Developer plugins declared via `plugins.use`: the loader resolves each
    // specifier, imports it, and calls its default-export factory with the
    // given options, producing the extension. Every plugin a specifier names
    // automatically runs.
    //
    // The app runs in developer mode: a plugin runs only when it is installed
    // with npm and listed in `use`, never from the admin panel or from
    // database state, and no installed-plugin state is persisted.
    use: [
      // Credential routes (`/api/login`, `/api/register`, and password reset
      // once enabled) are throttled by the plugin's default limiter
      // (`createMemoryRateLimiter`): 10 attempts per route, email, and client
      // address and 100 per client address in a 15-minute window, so a stranger
      // cannot lock an account out and one client cannot spray a password over
      // many accounts. Its state is per process: with more than one app process,
      // pass a shared (Valkey-backed) hook as `login.rateLimit`,
      // `registration.rateLimit`, and `passwordReset.rateLimit`. The client
      // address is the one core resolved: behind a reverse proxy the socket
      // address is the proxy's, so JSAILS_TRUSTED_PROXIES names the proxies
      // trusted to report the client (`jamal.config.ts` sets `hops=1` for
      // kamal-proxy on the `jamal deploy` path) and the address is the
      // X-Forwarded-For entry the outermost one appended. Left at `none` there,
      // every client shares the proxy's address and so one rate-limit bucket.
      //
      // Self-registration is on: `/register` posts to `/api/register`, which
      // creates the account without signing it in. A registered account holds
      // no role, so it cannot open the admin panel.
      // Password reset needs a mail transport and a reset page: see
      // `auth/README.md` before you add `passwordReset`.
      ['@jsails/auth', { registration: { enabled: true } }],
      '@jsails/cache',
      'jsails/dev',
      ['@jsails/filesystem', { disks: { [files.name]: files.disk }, default: files.name }],
      [
        '@jsails/mail',
        { allowMemory: process.env.NODE_ENV === 'development' || process.env.NODE_ENV === 'test' },
      ],
      // The live layer serves the blog's `blog.posts` publication over Socket.IO.
      // The registry is created here and handed to the plugin, which provides it
      // under a service token so the blog plugin can register its publication.
      // Without this entry the blog still works; it just has no live surface.
      ['@jsails/live', { registry: createPublicationRegistry() }],
      // The blog plugin provides the CMS repository service and the live list/create
      // HTTP surface; the database connection is owned by the repository above.
      [
        '@jsails/blog',
        {
          repository: blogRepository,
          editor: editorJsAdapter,
          themes: builtinThemePackages,
          search,
        },
      ],
      ['@jsails/admin', admin],
      // No signing key is hardcoded. In development/test the extension mints an
      // ephemeral key; a plain `jsails serve` outside those environments requires
      // JSAILS_COMPONENT_SECRET (>= 32 bytes) or the live render fails closed.
      // Components are discovered automatically from the compiler-generated
      // registry (`jsails build:meta`); no hand-written registry to import.
      'jsails/server-components',
    ],
  },
};
