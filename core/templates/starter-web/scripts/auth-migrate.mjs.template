// Apply the Better Auth schema migrations to the configured MariaDB database.
//
// Usage: node scripts/auth-migrate.mjs
//
// This script uses the same environment variables the app does
// (`DATABASE_HOST`, `DATABASE_PORT`, `DATABASE_USER`, `DATABASE_PASSWORD`,
// `DATABASE_NAME`, `BETTER_AUTH_SECRET`/`AUTH_SECRET`, `BETTER_AUTH_URL`). It
// is a plain Node script rather than a `jsails` command, so `npm run
// auth:migrate` loads `.env` and `.env.local` with Node's `--env-file-if-exists`
// (a real environment variable still wins). `loadAuthMigrations` comes
// from the `auth` plugin (`@jsails/auth`), not compiled
// app output, so no build is required first.
import { loadAuthMigrations } from '@jsails/auth';

console.log('Computing Better Auth schema migrations...');
const migrations = await loadAuthMigrations();

for (const table of migrations.toBeCreated) {
  console.log(`  create table ${table.table}`);
}
for (const table of migrations.toBeAdded) {
  console.log(`  alter table ${table.table}`);
}
for (const index of migrations.toBeAddedIndexes) {
  console.log(`  add index ${index.name} on ${index.table}`);
}

for (const problem of migrations.schemaProblems) {
  console.warn(`  schema problem: ${problem}`);
}
for (const unsafe of migrations.unsafeChanges) {
  console.warn(`  unsafe change: ${unsafe}`);
}

await migrations.runMigrations();

console.log('Migrations applied.');

// The Better Auth instance keeps a database connection pool open, which holds
// the event loop alive. Exit explicitly so a wrapper (the verify harness, CI, a
// shell pipeline) sees the process finish instead of hanging after the work.
process.exit(0);
