// Create the framework-owned database tables (sessions, plugin state, and — for
// the blog starter — blog posts) by reconciling the declared model schema
// against the live database.
//
// Usage: node scripts/db-push.mjs
//
// This script runs `jsails db:push`, which diffs the models in
// `jsails.database.js` against the live MariaDB database and applies the plan. It
// uses the same `DATABASE_*` environment variables the app does; the `jsails`
// CLI loads `.env` (then `.env.local` and `.env.<NODE_ENV>`) before it reads
// them, and a real environment variable always wins over the files.
// Re-running it is a no-op once the schema matches the models.
//
// The CLI is started as `node <jsails bin>` rather than through the
// `node_modules/.bin` shim: on Windows that shim is a `.cmd` file, which Node
// refuses to spawn without a shell, and no shell is needed here.
import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';

const config = 'jsails.database.js';
const require = createRequire(import.meta.url);
const manifestPath = require.resolve('jsails/package.json');
const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
const cli = join(dirname(manifestPath), manifest.bin.jsails);

console.log('Reconciling the database schema...');
const result = spawnSync(process.execPath, [cli, 'db:push', '--config', config], {
  stdio: 'inherit',
});
if (result.error) {
  console.error(`Failed to run jsails db:push: ${result.error.message}`);
  process.exit(1);
}
process.exit(result.status ?? 1);
