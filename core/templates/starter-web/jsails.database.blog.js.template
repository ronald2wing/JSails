// jsails.database.js — the data-source config for the JSails schema CLI
// (`db:push`, `db:diff`). It must be a compiled JavaScript module (a `.ts`
// path is rejected) whose default export is a `JsailsDataSource` instance.
//
// This module is imported only by the schema commands — never by
// `jsails build`/`serve`/`dev` (those import `jsails.app.js`).
// `readDatabaseEnvironment` resolves the connection settings here, so a missing
// `DATABASE_*` variable fails fast before any migration runs. The `jsails` CLI
// resolves the environment (`.env`, `.env.<JSAILS_ENV>`, the sealed
// credentials, `.env.local`) before importing this module, and a real
// environment variable wins over all of them. Run
// `npm run db:push` to generate and apply the history for the tables below.
//
// The framework-owned tables shipped here are the session table
// (`sessionEntities` → `jsails_session`), the media metadata table
// (`mediaEntities` → `jsails_media_asset`, used by the database-backed media
// index in `jsails.app.js`), and the site config table (`configEntities` →
// `jsails_config`, used by the config extension in `jsails.app.js`). The blog
// CMS tables are contributed by the `@jsails/blog` plugin's static schema, so
// `db:push` discovers them without listing them here. Add your own entities
// (for example a `User` EntitySchema) to the list.
import { JsailsDataSource, readDatabaseEnvironment, sessionEntities } from 'jsails';
import { configEntities } from '@jsails/config/database';
import { mediaEntities } from '@jsails/media';

export default new JsailsDataSource({
  ...readDatabaseEnvironment(),
  entities: [...sessionEntities, ...mediaEntities, ...configEntities],
});
