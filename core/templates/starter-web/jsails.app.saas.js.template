import { defineAdminPanel } from '@jsails/admin';
import {
  authSessionToken,
  createAuth,
  disposeCachedAuth,
  resolveSessionFromRequest,
} from '@jsails/auth';
import { createDiskFromEnv } from '@jsails/filesystem';
import { Tenant } from '@jsails/tenancy';

// Auth is the first-party `auth` plugin (`@jsails/auth`): it lazily builds a
// Better Auth instance (email/password + RFC 8628 device authorization) over
// MariaDB and mounts the `/api/auth/*`, `/api/login`, `/api/logout`, and
// `/api/device/approve|deny` routes as trusted hook routes. Importing this
// config reads no environment variable and opens no database connection — the
// first live request (or an auth script) builds the instance. The secret comes
// from BETTER_AUTH_SECRET (or AUTH_SECRET); Better Auth fails in production
// without one, and JSails does not invent a fallback. See `.env.auth.example`
// for the variables (JSails never auto-loads `.env`).

// Optional public origin for the login/logout same-origin checks. Behind a
// TLS-terminating proxy the request URL is plain HTTP, so set PUBLIC_ORIGIN to
// the public HTTPS origin; when unset the handlers fall back to each request's
// own origin.
const publicOrigin = process.env.PUBLIC_ORIGIN;

// FILESYSTEM_DISK selects local (default) or S3 for this disk.
const files = createDiskFromEnv();

// The admin panel: a dashboard mounted at `/admin`. It consumes the auth
// plugin's session service (so the `auth` plugin must be declared first),
// and its `authorize` is default-deny — here it allows any signed-in session,
// but production should restrict this to an admin role/claim.
const admin = defineAdminPanel({
  auth: authSessionToken,
  authorize: (session) => session !== null,
  // Admin pages load the client bundle so the rich-text editor island (and any
  // other app islands) hydrate over the server-rendered admin form markup.
  clientScripts: ['/assets/app.js'],
});

// A demo tenant resolver: derive a slug from the `x-tenant-slug` header (when
// present) or the request host's first label, and return a `Tenant` value only
// when one of those yields a usable slug — otherwise `null` (a global request).
// This is placeholder resolution for local development: a real application
// replaces it with a database lookup (e.g. `Tenant.findOne({ slug })`) backed
// by the plugin's `jsails_tenants` table.
function demoResolveTenant(request) {
  const host = new URL(request.url).hostname;
  const headerSlug = request.headers.get('x-tenant-slug');
  const slug = (headerSlug ?? host.split('.')[0] ?? '').toLowerCase();
  if (slug === '' || slug === 'localhost' || slug === '127') {
    return null;
  }
  // A stand-in tenant row: `id: 0` because this demo never reads a persisted
  // row, and `metadata: {}` to match the entity's nullable JSON column. A real
  // resolver replaces this with a `Tenant.findOne({ slug })` lookup.
  return Object.assign(new Tenant(), {
    id: 0,
    slug,
    name: slug,
    status: 'active',
    metadata: {},
  });
}

export default {
  rootDir: '.',
  pages: 'dist/pages',
  api: 'dist/api',
  public: 'public',
  out: 'out',
  host: '127.0.0.1',
  port: Number(process.env.PORT ?? 3000),
  // Consulted only for the login/logout same-origin checks (and any future
  // authenticated mutations). `undefined` keeps the request-origin fallback.
  publicOrigin,
  // Global API authorization: default-deny. Only a request with a session is
  // allowed; `/api/me` is the protected filesystem API, while login/logout are
  // trusted hook routes that never pass through this check.
  authorize: (context) => context.session !== null,
  // Trusted session seam: derive the JSails session from the Better Auth cookie.
  // This resolves a memoized instance via `createAuth()`, distinct from the one
  // the `auth` plugin builds in its own `setup`; both read the same environment
  // and database, so sessions resolve identically. Both pools must be released
  // on shutdown, or the open MariaDB sockets keep the process alive: the plugin
  // disposes its own instance, and the `setup` below disposes this one.
  resolveSession: (request) => resolveSessionFromRequest(createAuth(), request),
  // Release the memoized auth connection pool when the application closes. A
  // no-op when no session was ever resolved (the instance is built lazily).
  setup: () => disposeCachedAuth(),
  plugins: {
    // Developer plugins declared via `plugins.use`: the loader resolves each
    // specifier, imports it, and calls its default-export factory with the
    // given options, producing the extension. Every plugin a specifier names
    // automatically runs — developer plugins are never gated by `enabled`.
    //
    // `enabled` lists the marketplace/managed plugin ids shipped out of the
    // box; `managed: true` persists installed-plugin state in the database
    // (`jsails_plugin_state` table): add `pluginStateEntities` to your
    // `JsailsDataSource` `entities` and run `jsails db:push` to create the
    // table. `enabled` controls admin-installed plugins
    // only — the `use` entries above always run regardless of `enabled`.
    use: [
      // The `plugin-tools` plugin exposes the canonical shared tool modules
      // (cleanup, zod, trusted-mutation, responses) under a typed service token
      // for plugin authors. It runs before every default plugin.
      '@jsails/plugin-tools',
      ['@jsails/auth', { publicOrigin }],
      '@jsails/cache',
      'jsails/dev',
      ['@jsails/filesystem', { disks: { [files.name]: files.disk }, default: files.name }],
      [
        '@jsails/mail',
        { allowMemory: process.env.NODE_ENV === 'development' || process.env.NODE_ENV === 'test' },
      ],
      // Multi-tenancy: opt-in. `resolveTenant` is the demo host/header resolver
      // above; replace it with a database-backed lookup in a real app. The
      // plugin declares its entities statically, so `npm run db:migrate` creates
      // the `jsails_tenants`/`jsails_tenant_memberships` tables.
      ['@jsails/tenancy', { resolveTenant: demoResolveTenant }],
      // Feature flags: the zero-config in-memory store. Pass a
      // `DatabaseFeatureFlagStore` (from `@jsails/flags`) as `store` to persist
      // flags in the database — opt-in, never wired here.
      '@jsails/flags',
      ['@jsails/admin', admin],
      // No signing key is hardcoded. In development/test the extension mints an
      // ephemeral key; a plain `jsails serve` outside those environments requires
      // JSAILS_COMPONENT_SECRET (>= 32 bytes) or the live render fails closed.
      // Components are discovered automatically from the compiler-generated
      // registry (`jsails build:meta`); no hand-written registry to import.
      'jsails/server-components',
    ],
    enabled: __JSAILS_MANAGED_PLUGINS__,
    managed: true,
  },
};
