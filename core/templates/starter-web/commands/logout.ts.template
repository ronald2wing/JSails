/**
 * `jsails logout` command.
 *
 * Deletes the stored CLI session credentials. Idempotent: signing out when not
 * signed in is a no-op that still reports success and exits zero.
 */

import { Command } from '../app/application-command.js';

import { logout } from '../app/application-auth.js';

export default class LogoutCommand extends Command {
  static readonly signature = 'logout';
  static readonly summary = 'Delete the stored CLI session credentials';
  static readonly audience = 'user' as const;

  async handle(): Promise<number> {
    try {
      await logout();
      return 0;
    } catch (error) {
      this.stderr(error instanceof Error ? error.message : 'logout failed');
      return 1;
    }
  }
}
