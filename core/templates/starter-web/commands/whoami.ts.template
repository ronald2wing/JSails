/**
 * `jsails whoami` command.
 *
 * Prints the signed-in account (`name <email>`, or just the email). Fails with
 * a clear "not signed in" or "session expired" message (the latter also deletes
 * the stale credentials) and a nonzero exit when the session is absent or no
 * longer valid.
 */

import { Command } from '../app/application-command.js';

import { whoami } from '../app/application-auth.js';

export default class WhoamiCommand extends Command {
  static readonly signature = 'whoami';
  static readonly summary = 'Print the signed-in account (name and email)';
  static readonly audience = 'user' as const;

  async handle(): Promise<number> {
    try {
      await whoami();
      return 0;
    } catch (error) {
      this.stderr(error instanceof Error ? error.message : 'whoami failed');
      return 1;
    }
  }
}
