// jsails.config.js — the data-source config for the JSails schema CLI
// (`db:push`, `db:diff`). It must be a compiled JavaScript module (a `.ts`
// path is rejected) whose default export is a `JsailsDataSource` instance.
//
// This module is imported only by the schema commands — never by
// `jsails build`/`serve`/`dev` (those import `jsails.app.js`).
// `readDatabaseEnvironment` resolves the connection settings here, so a missing
// `DATABASE_*` variable fails fast before any migration runs; JSails never
// loads a `.env` file. Run `npm run db:migrate` to generate and apply the
// history for the tables below.
//
// The framework-owned tables shipped here are the session table
// (`sessionEntities` → `jsails_session`), the plugin-state table
// (`pluginStateEntities` → `jsails_plugin_state`, required by
// `plugins.managed: true` in `jsails.app.js`), and the media metadata table
// (`mediaEntities` → `jsails_media_asset`, used by the database-backed media
// index in `jsails.app.js`). The blog CMS tables are contributed by the
// `@jsails/blog` plugin's static schema, so `db:push` discovers them without
// listing them here. Add your own entities (for example a `User` EntitySchema)
// to the list.
import {
  JsailsDataSource,
  pluginStateEntities,
  readDatabaseEnvironment,
  sessionEntities,
} from 'jsails';
import { mediaEntities } from '@jsails/media';

export default new JsailsDataSource({
  ...readDatabaseEnvironment(),
  entities: [...sessionEntities, ...pluginStateEntities, ...mediaEntities],
});
