{
  "name": "jsails-static",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "jsails build:meta && tsc -p tsconfig.json && jsails inject:auto-imports && vite build && jsails build --config jsails.app.js && node --import ./.jsails/project-symbols.js scripts/generate-feeds.mjs",
    "typecheck": "jsails build:meta && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "serve": "jsails serve --config jsails.app.js",
    "export": "npm run build",
    "console": "jsails console"
  },
  "dependencies": {
    "@jsails/content": "^1.0.0",
    "@preact/signals": "^2.11.3",
    "jsails": "__JSAILS_DEPENDENCY__",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
