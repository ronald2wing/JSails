{
  "name": "@jsails/ai",
  "version": "1.0.0",
  "description": "A provider-neutral AI runtime for JSails: a streaming run loop with approvals and budgets, content model, tools with strict-schema lowering, structured output, usage and cost, conversations, an SSE event stream with a browser client, test doubles, and an MCP tool bridge.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/ai"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "default": "./dist/src/client/index.js"
    },
    "./anthropic": {
      "types": "./dist/src/anthropic/index.d.ts",
      "default": "./dist/src/anthropic/index.js"
    },
    "./openai-compatible": {
      "types": "./dist/src/openai-compatible/index.d.ts",
      "default": "./dist/src/openai-compatible/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/index.d.ts",
      "default": "./dist/src/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "peerDependencies": {
    "jsails": "^1.0.0",
    "zod": "^4.6.7",
    "@anthropic-ai/sdk": "^1.0.0",
    "openai": "^7.0.0"
  },
  "devDependencies": {
    "jsails": "^1.0.0",
    "zod": "^4.6.7",
    "@anthropic-ai/sdk": "1.11.0",
    "openai": "7.61.0",
    "@modelcontextprotocol/client": "2.4.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  }
}
