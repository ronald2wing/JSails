{
  "name": "@jsails/editor",
  "version": "1.0.0",
  "description": "The Editor.js rich-text editor for JSails: document conversion, a Preact island, and server rendering.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./preact": {
      "types": "./dist/src/preact/index.d.ts",
      "default": "./dist/src/preact/index.js"
    },
    "./server": {
      "types": "./dist/src/server/index.d.ts",
      "default": "./dist/src/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@editorjs/code": "^2.9.3",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6"
  },
  "peerDependencies": {
    "jsails": "^1.0.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "jsails": "^1.0.0",
    "preact": "^11.0.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  }
}
