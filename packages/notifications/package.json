{
  "name": "@jsails/notifications",
  "version": "1.0.0",
  "description": "A multi-channel notification delivery seam for JSails with in-memory and mail channels.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/notifications"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./database": {
      "types": "./dist/src/database/index.d.ts",
      "default": "./dist/src/database/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@jsails/mail": "^1.0.0"
  },
  "peerDependencies": {
    "jsails": "1.0.0"
  },
  "devDependencies": {
    "jsails": "1.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "manifestVersion": 1,
    "id": "jsails-notifications",
    "version": "1.0.0",
    "name": "Notifications",
    "summary": "Multi-channel notification delivery with in-memory, database, and mail channels.",
    "publisher": "jsails",
    "jsailsCompat": "^1.0.0",
    "apiTier": "stable",
    "permissions": [
      "services.provide",
      "mail.send"
    ],
    "entry": "@jsails/notifications"
  }
}
