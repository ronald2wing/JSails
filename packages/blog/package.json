{
  "name": "@jsails/blog",
  "version": "1.0.0",
  "description": "The standalone blog CMS for JSails: content model, repositories, public routes, search, and admin resources.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/blog"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./admin": {
      "types": "./dist/src/admin/index.d.ts",
      "default": "./dist/src/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@jsails/content": "^1.0.0",
    "@jsails/editor": "^1.0.0",
    "@jsails/theme": "^1.0.0",
    "@orama/orama": "^3.1.18"
  },
  "peerDependencies": {
    "@jsails/admin": "^1.0.0",
    "jsails": "^1.0.0",
    "preact": "^11.0.1",
    "typeorm": "^1.1.1",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@jsails/admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jsails/admin": "^1.0.0",
    "hono": "^4.13.13",
    "jsails": "^1.0.0",
    "preact": "^11.0.1",
    "typeorm": "^1.1.1",
    "zod": "^4.6.7",
    "@jsails/editor": "1.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "id": "jsails-blog",
    "version": "1.0.0",
    "jsailsCompat": "^1.0.0",
    "permissions": [
      "http.routes",
      "database.read",
      "database.write"
    ],
    "entry": "@jsails/blog"
  }
}
