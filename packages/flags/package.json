{
  "name": "@jsails/flags",
  "version": "1.0.0",
  "description": "Feature flags for JSails: in-memory and database stores, rollout scopes, and an optional admin page.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/flags"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./admin": {
      "types": "./dist/src/admin/index.d.ts",
      "default": "./dist/src/admin/index.js"
    },
    "./database": {
      "types": "./dist/src/database/index.d.ts",
      "default": "./dist/src/database/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "peerDependencies": {
    "@jsails/admin": "^1.0.0",
    "jsails": "^1.0.0",
    "preact": "^11.2.0",
    "typeorm": "^1.1.3"
  },
  "peerDependenciesMeta": {
    "@jsails/admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jsails/admin": "^1.0.0",
    "@jsails/cache": "^1.0.0",
    "jsails": "^1.0.0",
    "preact": "^11.2.0",
    "typeorm": "^1.1.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "manifestVersion": 1,
    "id": "jsails-flags",
    "version": "1.0.0",
    "name": "Feature Flags",
    "summary": "Feature flags with in-memory and database stores and rollout scopes.",
    "publisher": "jsails",
    "jsailsCompat": "^1.0.0",
    "apiTier": "stable",
    "permissions": [
      "services.provide"
    ],
    "plugins": [
      {
        "id": "jsails-cache",
        "range": "^1.0.0"
      }
    ],
    "entry": "@jsails/flags"
  }
}
