{
  "name": "@jsails/tenancy",
  "version": "1.0.0",
  "description": "Opt-in tenant and membership schema plus auth-agnostic tenant resolution for JSails.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/tenancy"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "peerDependencies": {
    "jsails": "^1.0.0",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsails": "^1.0.0",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "manifestVersion": 1,
    "id": "jsails-tenancy",
    "version": "1.0.0",
    "name": "Tenancy",
    "summary": "Tenant and membership schema and auth-agnostic tenant resolution per request.",
    "publisher": "jsails",
    "jsailsCompat": "^1.0.0",
    "apiTier": "stable",
    "permissions": [
      "http.scope",
      "services.provide",
      "data.own",
      "auth.session.read"
    ],
    "entry": "@jsails/tenancy",
    "schema": {
      "tablePrefix": "jsails_tenant"
    }
  }
}
