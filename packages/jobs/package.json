{
  "name": "@jsails/jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Background jobs for JSails: typed job definitions, the versioned envelope, declared queues, the neutral adapter contract, the in-memory transport, the Valkey transport on BullMQ, the worker runtime (outcomes, bounded drain and abort, the poisoned-worker rule, value-free failures), and the adapter conformance suite.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/jobs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./valkey": {
      "types": "./dist/src/valkey/index.d.ts",
      "default": "./dist/src/valkey/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "peerDependencies": {
    "bullmq": "^6.7.8",
    "jsails": "1.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jsails/cache": "^1.0.0",
    "bullmq": "^6.7.8",
    "jsails": "1.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  }
}
