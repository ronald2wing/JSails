{
  "name": "@jsails/mail",
  "version": "1.0.0",
  "description": "A transport-agnostic mail seam for JSails with in-memory, callback, and lazy SMTP transports.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/mail"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "nodemailer": "^10.2.0"
  },
  "peerDependencies": {
    "jsails": "^1.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "jsails": "^1.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "manifestVersion": 1,
    "id": "jsails-mail",
    "version": "1.0.0",
    "name": "Mail",
    "summary": "A transport-agnostic mail service with in-memory, callback, and SMTP transports.",
    "publisher": "jsails",
    "jsailsCompat": "^1.0.0",
    "apiTier": "stable",
    "permissions": [
      "http.routes",
      "services.provide"
    ],
    "entry": "@jsails/mail",
    "env": [
      {
        "name": "MAIL_URL",
        "kind": "secret",
        "description": "The SMTP transport URL, which may carry credentials."
      },
      {
        "name": "SMTP_URL",
        "kind": "secret",
        "description": "The fallback name for the SMTP transport URL."
      }
    ]
  }
}
