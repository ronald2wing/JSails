{
  "name": "@jsails/config",
  "version": "1.0.0",
  "description": "Configuration management for JSails: typed config sets edited in the admin, exported to sync files, imported on deploy, and overridable from code.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./admin": {
      "types": "./dist/src/admin/index.d.ts",
      "default": "./dist/src/admin/index.js"
    },
    "./database": {
      "types": "./dist/src/database/index.d.ts",
      "default": "./dist/src/database/index.js"
    },
    "./commands/export": {
      "types": "./dist/src/commands/export.d.ts",
      "default": "./dist/src/commands/export.js"
    },
    "./commands/import": {
      "types": "./dist/src/commands/import.d.ts",
      "default": "./dist/src/commands/import.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "peerDependencies": {
    "@jsails/admin": "^1.0.0",
    "jsails": "^1.0.0",
    "preact": "^11.0.1",
    "typeorm": "^1.1.1"
  },
  "peerDependenciesMeta": {
    "@jsails/admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jsails/admin": "^1.0.0",
    "@jsails/cache": "^1.0.0",
    "jsails": "^1.0.0",
    "preact": "^11.0.1",
    "typeorm": "^1.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "manifestVersion": 1,
    "id": "jsails-config",
    "version": "1.0.0",
    "name": "Configuration",
    "summary": "Typed config sets edited in the admin, exported to sync files, and imported on deploy.",
    "publisher": "jsails",
    "jsailsCompat": "^1.0.0",
    "apiTier": "stable",
    "permissions": [
      "services.provide",
      "data.own"
    ],
    "plugins": [
      {
        "id": "jsails-cache",
        "range": "^1.0.0"
      }
    ],
    "entry": "@jsails/config",
    "commands": [
      {
        "name": "config:export",
        "summary": "Write the active config of every set to the sync directory",
        "module": "@jsails/config/commands/export"
      },
      {
        "name": "config:import",
        "summary": "Apply the sync directory to the active config, all or nothing",
        "module": "@jsails/config/commands/import"
      }
    ],
    "schema": {
      "tablePrefix": "jsails_config"
    }
  }
}
