{
  "name": "@jsails/auth",
  "version": "1.0.0",
  "description": "Better Auth over MariaDB as a JSails plugin: email/password and device-flow sign-in, sessions, roles, and revocable API tokens.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "test:watch": "node ../../scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@jsails/mail": "^1.0.0",
    "better-auth": "^1.7.12",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.5"
  },
  "peerDependencies": {
    "jsails": "^1.0.0"
  },
  "devDependencies": {
    "jsails": "^1.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "id": "jsails-auth",
    "version": "1.0.0",
    "jsailsCompat": "^1.0.0",
    "permissions": [
      "http.routes",
      "database.read",
      "database.write",
      "mail.send"
    ],
    "entry": "@jsails/auth"
  }
}
