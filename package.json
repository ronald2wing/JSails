{
  "name": "jsails-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "build:clean": "node scripts/run-workspaces.mjs build:clean",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "test": "npm run build && npm run test:workspaces && npm run test:scripts",
    "test:workspaces": "node scripts/run-workspaces.mjs test",
    "test:coverage": "node scripts/run-workspaces.mjs test -- --coverage",
    "test:database": "node scripts/run-workspaces.mjs test -- --suite=database",
    "test:scripts": "node scripts/budgeted.mjs --label test:scripts --mb 1100 --cpu 4 -- node --test --test-concurrency={jobs} \"scripts/test/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "lint:ci": "node scripts/lint.mjs --no-cache",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "prettier --write .",
    "format:check": "node scripts/budgeted.mjs --label format:check --mb 600 --cpu 1 -- node node_modules/prettier/bin/prettier.cjs --check .",
    "gates": "node scripts/run-gates.mjs",
    "check:structure": "node scripts/run-gates.mjs src-structure licenses codemap plugin-manifests data-specs",
    "check:declared-deps": "node scripts/run-gates.mjs declared-deps",
    "check:access": "node scripts/run-gates.mjs access",
    "check": "npm run build:clean && node scripts/run-parallel.mjs lint:ci format:check gates test:scripts test:coverage",
    "coverage:floors": "node scripts/coverage-floors.mjs --write",
    "verify:starter": "node scripts/budgeted.mjs --label verify:starter --mb 2200 -- node scripts/verify-starter/index.mjs",
    "verify:integrations": "node scripts/budgeted.mjs --label verify:integrations --mb 2000 -- node scripts/verify-integrations.mjs",
    "website": "npm run build -w jsails -w @jsails/content && npm --prefix website ci && npm --prefix website run build",
    "release": "node scripts/release.mjs",
    "bench": "node scripts/bench/index.mjs",
    "api-report": "node scripts/api-report.mjs",
    "codemap": "node scripts/build-codemap.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hotwired__turbo": "^8.0.16",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
