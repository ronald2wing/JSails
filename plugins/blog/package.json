{
  "name": "@jsails/blog",
  "version": "1.0.0",
  "description": "Tenant-free blog CMS: content model, repository, admin resource, plugin, and database persistence.",
  "license": "MIT",
  "author": "Ronald Wong <ronald2wing@gmail.com>",
  "homepage": "https://jsails.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronald2wing/JSails.git",
    "directory": "plugins/blog"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "test:watch": "node --test --watch \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "jsails": "1.0.0",
    "typeorm": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "hono": "^4.13.13",
    "jsails": "1.0.0",
    "typeorm": "^1.1.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@jsails/admin": "1.0.0",
    "@jsails/theme": "1.0.0",
    "@orama/orama": "^3.1.18",
    "markdown-it": "^15.0.3",
    "preact": "^11.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ronald2wing/JSails/issues"
  },
  "jsails": {
    "id": "jsails-blog",
    "version": "1.0.0",
    "jsailsCompat": "^1.0.0",
    "permissions": [
      "http.routes",
      "database.read",
      "database.write"
    ],
    "entry": "@jsails/blog"
  }
}
